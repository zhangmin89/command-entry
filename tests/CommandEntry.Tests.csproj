<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>false</PublishAot>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../src/CommandEntry/CommandEntry.csproj"/>
    <Content Include="Fixtures/reference.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="CommandEntry.TestProbe/CommandEntry.TestProbe.csproj" ReferenceOutputAssembly="false" />
    <Compile Remove="CommandEntry.TestProbe/**/*.cs" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <TestingPlatformBuilderHook Include="AE4AB19D-4C81-41AE-A942-67E9F5435329" DisplayName="Test progress" TypeFullName="CommandEntry.Tests.TestProgressBuilderHook" />
    <AssemblyMetadata Include="RepositoryRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/..'))" />
    <AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)" />
  </ItemGroup>
</Project>
